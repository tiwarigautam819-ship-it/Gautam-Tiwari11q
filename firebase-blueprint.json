{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Student in B.Tech Computer Science & Engineering Section A",
      "type": "object",
      "properties": {
        "rollNumber": { "type": "string", "description": "Student class roll number (e.g. 01, 02)" },
        "name": { "type": "string", "description": "Student full name" },
        "enrollmentNumber": { "type": "string", "description": "College enrollment number" },
        "class": { "type": "string", "description": "Degree program" },
        "branch": { "type": "string", "description": "Engineering branch" },
        "semester": { "type": "string", "description": "Academic semester" },
        "section": { "type": "string", "description": "Section" },
        "active": { "type": "boolean", "description": "Status of enrollment" },
        "createdAt": { "type": "string", "description": "Record creation timestamp" },
        "updatedAt": { "type": "string", "description": "Record update timestamp" }
      },
      "required": ["rollNumber", "name", "enrollmentNumber", "active"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Attendance record for a specific date and student",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Attendance date in YYYY-MM-DD" },
        "studentId": { "type": "string", "description": "Referenced student document ID" },
        "status": { "type": "string", "enum": ["Present", "Absent"], "description": "Attendance state" },
        "markedAt": { "type": "string", "description": "Timestamp when attendance was marked" },
        "markedBy": { "type": "string", "description": "Admin/teacher user ID" }
      },
      "required": ["date", "studentId", "status", "markedAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/student" },
      "description": "Directory of Section A CSE students"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/attendance" },
      "description": "Individual student attendance records, keyed by {date}_{studentId}"
    }
  }
}
