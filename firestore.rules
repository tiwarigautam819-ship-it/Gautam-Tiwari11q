rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared Centralized Institution Data for Sobhasaria Group of Institutions (B.Tech CSE Section A)
    // Synchronized across all devices, mobile APKs, and faculty logins
    match /students/{studentId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

